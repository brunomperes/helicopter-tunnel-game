{
	"name": "helicopter-tunnel-game",
	"version": "0.0.0",
	"description": "One-button helicopter-through-scrolling-tunnel game",
	"scripts": {
		"test": "vitest run",
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"format": "biome check --write"
	},
	"keywords": [
		"game",
		"canvas",
		"typescript"
	],
	"license": "MIT",
	"packageManager": "pnpm@10.11.0",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
